{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATTACK SHARK X3",
  "version": "0.1.0",
  "identifier": "com.lucasbrito.attack-shark-x3",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "beforeBuildCommand": "bun run --cwd ../ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ATTACK SHARK X3",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "ATTACK SHARK X3 mouse configurator",
    "longDescription": "Configure DPI, polling rate, buttons and macros of the ATTACK SHARK X3 mouse.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/etc/udev/rules.d/99-attack-shark-x3.rules": "../packaging/linux/99-attack-shark-x3.rules"
        },
        "postInstallScript": "../packaging/linux/deb/postinst"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENTVDMTM5QkM1NDQwMjMKUldRalFGUzhPY0ZWN2ZTVlJ6UmNvVWFsR1g3ZHMyU3gzWjhxREpnVnUzSEo5ZDdHMmJ5TXlKa0sK",
      "endpoints": ["https://github.com/lucasbrito-wdt/attack-shark-x3/releases/latest/download/latest.json"]
    }
  }
}
